def main():
    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler('start', start))
    app.add_handler(CommandHandler('shn', shn))
    app.add_handler(CommandHandler('unsubscribe', unsubscribe))
    app.add_handler(CommandHandler('myinfo', myinfo))
    app.add_handler(CommandHandler('status', status))
    app.add_handler(CommandHandler('help', send_help_message))
    app.add_handler(CommandHandler('exportjson', exportjson))
    app.add_handler(CommandHandler('exportcsv', exportcsv))
    app.add_handler(CommandHandler('cancel', cancel))
    app.add_handler(CommandHandler('R', reply_command))
    app.add_handler(CommandHandler('broadcast', broadcast_command))
    app.add_handler(CommandHandler('health', health))

    app.add_handler(CallbackQueryHandler(button_handler))

    conv_handler = ConversationHandler(
        entry_points=[
            MessageHandler(filters.TEXT & filters.User(user_id=OWNER_ID), handle_reply),
            MessageHandler(filters.TEXT & filters.User(user_id=OWNER_ID), handle_broadcast)
        ],
        states={
            WAITING_FOR_REPLY_MESSAGE: [MessageHandler(filters.TEXT, handle_reply)],
            WAITING_FOR_BROADCAST_MESSAGE: [MessageHandler(filters.TEXT, handle_broadcast)],
        },
        fallbacks=[CommandHandler('cancel', cancel)]
    )
    app.add_handler(conv_handler)

    print("🚀 Super Advanced Luncher Bot is running...")
    app.run_polling()

if __name__ == '__main__':
    main()
