async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    user = query.from_user
    user_id_str = str(user.id)
    username = user.username or "NoUsername"

    await query.answer()

    data = load_data()

    if query.data == 'get_notify':
        if user_id_str not in data:
            await query.edit_message_text("❗ Please send /start first to register.")
            return
        if data[user_id_str].get('status') == 'ON':
            await query.edit_message_text("✅ You are already subscribed to notifications.")
            return

        data[user_id_str]['status'] = 'ON'
        save_data(data)

        await query.edit_message_text("👍 Thanks! You will be notified when events start.")

        await context.bot.send_message(
            chat_id=OWNER_ID,
            text=f"🔔 User subscribed:\n👤 @{username}\n🆔 {user_id_str}\nUSERSTATUS: ON"
        )
        logger.info(f"User @{username} ({user_id_str}) subscribed for notifications.")
        return

    elif query.data == 'help':
        help_text = (
            "ℹ️ <b>How to Use Luncher Bot</b>\n\n"
            "• /start - Register with the bot.\n"
            "• /shn - Enter SHN section and subscribe.\n"
            "• Click 'Get Notify' once to get event notifications.\n"
            "• /myinfo - Check your subscription status.\n"
            "• /unsubscribe - Stop notifications.\n"
            "• Owner manages users and can reply to you.\n"
            "Enjoy!"
        )
        await query.edit_message_text(help_text, parse_mode='HTML')

