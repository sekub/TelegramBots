# ===== DATA HANDLING =====
def load_data() -> Dict[str, Any]:
    try:
        with open(DATA_FILE, 'r') as f:
            data = json.load(f)
        logger.info("Loaded user data successfully.")
        return data
    except (FileNotFoundError, json.JSONDecodeError):
        logger.warning("User data file missing or corrupted. Initializing empty data.")
        return {}

def save_data(data: Dict[str, Any]):
    with open(DATA_FILE, 'w') as f:
        json.dump(data, f, indent=4)
    logger.info("User data saved.")

# ===== RATE LIMITING =====
user_last_command_time = {}

def rate_limit(user_id: int) -> bool:
    now = datetime.now().timestamp()
    last = user_last_command_time.get(user_id, 0)
    if now - last < RATE_LIMIT_SECONDS:
        return False
    user_last_command_time[user_id] = now
    return True

# === Utility ===
def get_uptime():
    seconds = int(time.time() - START_TIME)
    return str(datetime.timedelta(seconds=seconds))

