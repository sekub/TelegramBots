async def reply_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != OWNER_ID:
        return
    if len(context.args) != 1:
        await update.message.reply_text("Usage: R <user_id>")
        return
    uid = context.args[0]
    reply_target[OWNER_ID] = uid
    await update.message.reply_text("✏️ Send me the message to send to the user.")
    return WAITING_FOR_REPLY_MESSAGE

async def handle_reply(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.message.text
    uid = reply_target.pop(OWNER_ID, None)
    if uid:
        try:
            await context.bot.send_message(chat_id=int(uid), text=message)
            await update.message.reply_text("✅ Message sent to user.")
        except:
            await update.message.reply_text("❌ Failed to send message.")
    return ConversationHandler.END

