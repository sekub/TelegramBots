async def exportjson(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != OWNER_ID:
        return
    try:
        with open(DATA_FILE, 'rb') as f:
            await update.message.reply_document(document=f, filename=DATA_FILE)
    except Exception as e:
        await update.message.reply_text(f"❌ Failed to send JSON: {e}")

async def exportcsv(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != OWNER_ID:
        return
    data = load_data()
    with open('users.csv', 'w', newline='') as f:
        writer = csv.writer(f)
        writer.writerow(['ID', 'Name', 'Username', 'Status', 'StartDate'])
        for uid, info in data.items():
            writer.writerow([uid, info['name'], info['username'], info['status'], info['start_date']])
    with open('users.csv', 'rb') as f:
        await update.message.reply_document(f, filename='users.csv')

